{
  "name": "harut",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e 'console.log(\"Build complete\")'",
    "lint": "node --check server.js cone3d.js preview.js && node scripts/validate-math.js && node scripts/validate-page-fill.js",
    "test:math": "node scripts/validate-math.js",
    "test:fill": "node scripts/validate-page-fill.js",
    "build:pages": "node scripts/split-pages.mjs",
    "build:manifest": "node scripts/build-workbook-manifest.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "build:pdf": "node scripts/build-pdf.mjs",
    "build:workbook": "node scripts/split-pages.mjs && node scripts/build-pdf.mjs && node scripts/verify-manifest.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "pdf-lib": "1.17.1"
  }
}
